# ── Supabase (required) ──────────────────────────────────────────────────────
# Find these in your Supabase project → Settings → API

# Public anon key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — SERVER ONLY, never expose to the browser
# Used in API Route Handlers for admin operations (user management, pipeline trigger)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── GitHub Actions pipeline trigger (optional) ────────────────────────────────
# Personal access token with workflow:write scope, used by the admin pipeline page
# to manually trigger the capture workflow
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=garciaandsmith
GITHUB_REPO=tenderloin
